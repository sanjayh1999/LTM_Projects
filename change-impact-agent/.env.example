# Database (matches the docker-compose Postgres+pgvector service we'll set up next)
DATABASE_URL=postgresql://citool:citool@localhost:5432/change_impact

# LLM provider — set which one you're using; fill in only that section
LLM_PROVIDER=anthropic
LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# App
APP_ENV=development
LOG_LEVEL=INFO